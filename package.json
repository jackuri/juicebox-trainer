{
  "name": "juicebox-trainer",
  "version": "1.27.1",
  "private": true,
  "description": "Free, open-source trainer + save editor for PC games without anti-cheat.",
  "license": "MIT",
  "workspaces": [
    "apps/desktop",
    "sidecars/ai-agent"
  ],
  "scripts": {
    "dev": "npm run tauri --workspace @juicebox-trainer/desktop -- dev",
    "build:web": "npm run build --workspace @juicebox-trainer/desktop",
    "lint": "npm run lint --workspace @juicebox-trainer/desktop",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check.ps1",
    "bump": "node scripts/bump-version.mjs",
    "build:agent": "npm run build --workspace @juicebox-trainer/ai-agent"
  },
  "engines": {
    "node": ">=22"
  }
}
