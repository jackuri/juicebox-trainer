{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JuiceBox Remote",
  "version": "1.36.0",
  "identifier": "org.juiceboxtrainer.remote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JuiceBox Remote",
        "width": 400,
        "height": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "publisher": "JuiceBox Trainer contributors",
    "copyright": "Copyright (c) JuiceBox Trainer contributors. MIT License.",
    "category": "Utility",
    "shortDescription": "Phone remote for JuiceBox Trainer",
    "homepage": "https://github.com/jackuri/juicebox-trainer",
    "license": "MIT",
    "icon": ["icons/icon.png"]
  }
}
