{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JuiceBox Trainer",
  "version": "1.25.0",
  "identifier": "org.juiceboxtrainer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "JuiceBox Trainer",
        "width": 1200,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "JuiceBox Trainer contributors",
    "copyright": "Copyright (c) JuiceBox Trainer contributors. MIT License.",
    "category": "Utility",
    "shortDescription": "Trainer and save manager for single-player PC games",
    "longDescription": "Free, open-source trainer, save manager and AI cheat-pack maker for single-player PC games. Refuses games with anti-cheat.",
    "homepage": "https://github.com/jackuri/juicebox-trainer",
    "license": "MIT",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../sidecars/ai-agent/dist/*.js": "ai-agent/",
      "../../../sidecars/ai-agent/dist/package.json": "ai-agent/package.json"
    },
    "fileAssociations": [
      {
        "ext": [
          "juice"
        ],
        "name": "JuiceBox Trainer pack",
        "description": "JuiceBox Trainer cheat pack",
        "role": "Viewer",
        "mimeType": "application/x-juicebox-pack"
      },
      {
        "ext": [
          "otpack"
        ],
        "name": "OpenTrainer pack",
        "description": "Cheat pack (from OpenTrainer)",
        "role": "Viewer",
        "mimeType": "application/x-opentrainer-pack"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBBNjlGQUUyQUIzRkRDQTUKUldTbDNEK3I0dnBwQ29zM2hRcU9qL290ZzZ6aGxqZytVbHF3dDJCT2tXQk5aZExmY0toYkgwZ0sK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
