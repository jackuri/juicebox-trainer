{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opentrainer.org/schema/pack.v1.json",
  "title": "OpenTrainer cheat pack v1",
  "description": "Declarative cheat pack for a PC single-player game. The app also runs checks this schema can't express (unique ids, hotkey conflicts, values that fit their type, safe patch instructions); run `otpack validate` for the full check.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "game", "meta", "cheats"],
  "properties": {
    "schema": { "const": 1 },
    "game": { "$ref": "#/$defs/game" },
    "meta": { "$ref": "#/$defs/meta" },
    "cheats": { "type": "array", "items": { "$ref": "#/$defs/cheat" } },
    "saveCodes": {
      "description": "Save-file quick codes, applied from the Save backups view (game closed, saves backed up first).",
      "type": "array",
      "items": { "$ref": "#/$defs/saveCode" }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "moduleName": { "type": "string", "pattern": "^[^/\\\\:]+\\.(exe|dll|EXE|DLL)$" },
    "aob": {
      "description": "Hex bytes and ?? wildcards separated by spaces, e.g. \"48 8B 05 ?? ?? ?? ??\".",
      "type": "string",
      "pattern": "^\\s*([0-9A-Fa-f]{2}|\\?\\??)(\\s+([0-9A-Fa-f]{2}|\\?\\??))*\\s*$"
    },
    "bytes": {
      "description": "Hex bytes separated by spaces, no wildcards.",
      "type": "string",
      "pattern": "^\\s*[0-9A-Fa-f]{2}(\\s+[0-9A-Fa-f]{2})*\\s*$"
    },
    "hexOffset": { "type": "string", "pattern": "^[+-]?(0[xX])?[0-9A-Fa-f_]+$" },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "exe"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "engine": { "type": "string" },
        "exe": { "type": "string", "pattern": "^[^/\\\\:]+\\.(exe|EXE)$" },
        "arch": {
          "description": "Required when the pack has patch cheats.",
          "enum": ["x86", "x64"]
        },
        "builds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256"],
            "properties": {
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "label": { "type": "string" },
              "verified": { "type": "boolean" }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "packVersion"],
      "properties": {
        "author": { "description": "\"ai\" marks a pack made by the AI creator.", "type": "string", "minLength": 1 },
        "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "packVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([-+].*)?$" },
        "notes": { "type": "string" },
        "source": {
          "description": "Credit for cheats made by someone else, e.g. a converted Cheat Engine table (v1.15.0).",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "by": { "description": "Who made them.", "type": "string", "minLength": 1, "maxLength": 100 },
            "url": { "description": "The page they were published on.", "type": "string", "pattern": "^https?://[^/\\s]", "maxLength": 400 },
            "file": { "description": "The file they were converted from.", "type": "string", "minLength": 1, "maxLength": 200 }
          }
        }
      }
    },
    "cheat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "ui", "impl"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "ui": { "enum": ["toggle", "slider", "number", "button"] },
        "hotkey": {
          "description": "Toggles and buttons only. e.g. F1, Ctrl+Num1, Alt+Shift+F5. Letters, digits and Space need Ctrl or Alt.",
          "type": "string"
        },
        "toggle": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "value": { "description": "Freeze at this value (default: the current value).", "type": "number" } }
        },
        "slider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max", "step"],
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" },
            "step": { "type": "number", "exclusiveMinimum": 0 },
            "default": { "type": "number" },
            "hold": { "description": "Keep the value frozen after setting it.", "type": "boolean" }
          }
        },
        "number": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" },
            "hold": { "type": "boolean" }
          }
        },
        "button": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": { "add": { "type": "number" }, "set": { "type": "number" } }
        },
        "impl": { "oneOf": [{ "$ref": "#/$defs/valueImpl" }, { "$ref": "#/$defs/patchImpl" }] }
      }
    },
    "valueImpl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "type", "address"],
      "properties": {
        "kind": { "const": "value" },
        "type": { "enum": ["i8", "u8", "i16", "u16", "i32", "u32", "i64", "u64", "f32", "f64"] },
        "address": { "$ref": "#/$defs/address" }
      }
    },
    "address": {
      "description": "Either base (module.exe+0x…) or aob. AOB: match + offset is the start; operand abs32 reads a 32-bit address there (x86), rip32 reads a 32-bit displacement there and adds it to match + next (x64). Then each entry of offsets: read a pointer, add the offset.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base": { "type": "string" },
        "aob": { "$ref": "#/$defs/aob" },
        "module": { "$ref": "#/$defs/moduleName" },
        "offset": { "type": "integer" },
        "operand": { "enum": ["rip32", "abs32"] },
        "next": { "type": "integer" },
        "offsets": { "type": "array", "items": { "$ref": "#/$defs/hexOffset" } },
        "capture": {
          "description": "AOB form only, no operand: the start point is the value of a register when the game runs the code at match + offset (read with a hardware breakpoint; no code is changed), plus add. Then offsets apply. Needs game.arch.",
          "type": "object",
          "additionalProperties": false,
          "required": ["register"],
          "properties": {
            "register": { "type": "string", "description": "rax..r15 or their low halves (eax, r8d) for x64 games; eax..edi for x86." },
            "add": { "$ref": "#/$defs/hexOffset" },
            "when": {
              "type": "object",
              "additionalProperties": false,
              "required": ["register", "equals"],
              "properties": { "register": { "type": "string" }, "equals": { "type": "integer" } }
            }
          }
        }
      },
      "oneOf": [{ "required": ["base"] }, { "required": ["aob"] }]
    },
    "patchImpl": {
      "description": "Replaces original bytes at aob match + offset. Must be a toggle. Replacement instructions are checked: no calls, indirect jumps, system calls or privileged instructions; jumps stay in the module.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "aob", "original", "replace"],
      "properties": {
        "kind": { "const": "patch" },
        "module": { "$ref": "#/$defs/moduleName" },
        "aob": { "$ref": "#/$defs/aob" },
        "offset": { "type": "integer" },
        "original": { "$ref": "#/$defs/bytes" },
        "replace": { "$ref": "#/$defs/bytes" }
      }
    },
    "saveCode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "codec", "file", "set"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "name": { "type": "string", "minLength": 1 },
        "codec": {
          "description": "Format of the save. auto accepts any format OpenTrainer can read.",
          "enum": ["auto", "json", "xml", "ini", "yaml", "gvas", "sqlite", "playerprefs"]
        },
        "file": {
          "description": "Save file (or, for playerprefs, the registry key under HKCU\\Software), starting with a folder placeholder, e.g. {localappdatalow}/Company/Game/save1.json or {playerprefs}/Company/Game.",
          "type": "string",
          "pattern": "^\\{(documents|mygames|savedgames|appdata|localappdata|localappdatalow|playerprefs)\\}[/\\\\].+"
        },
        "set": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "value"],
          "properties": {
            "path": {
              "description": "Value to set, as the save editor names it: player.gold, items[2].count, Stats.Level.",
              "type": "string",
              "minLength": 1
            },
            "value": { "type": ["number", "string", "boolean"] }
          }
        }
      }
    }
  }
}
